@model DeleteOrganizationViewModel
@{
    ViewData["Title"] = "Delete Organization " + Model.AccountName;
}

<section role="main" class="container main-container page-delete-account">
    <div class="form-group">
        <div class="form-group package-controls">
            <nav aria-label="breadcrumb"><ol class="breadcrumb"><li><a asp-controller="Organizations" asp-action="ManageMyOrganizations">Organizations</a></li><li><a asp-controller="Organizations" asp-action="ManageOrganization" asp-route-accountName="@Model.AccountName">@Model.AccountName</a></li><li class="active" aria-current="page">Delete</li></ol></nav>
            <div class="alert alert-warning" role="alert"><strong class="keywords">Important</strong> Once your organization is deleted you cannot undo it. <b>The organization name will be reserved and it will not be able to be reused.</b> <a href="https://go.microsoft.com/fwlink/?linkid=862770">Read more.</a></div>
            <p>When your organization is deleted we will:<br />
                <ul>
                    <li>Remove your organization from ownership of any packages.</li>
                    <li>Remove your organization from ownership of any ID prefix reservations and delete any ID prefix reservations that your organization was the only owner of.</li>
                    <li>Not delete the published NuGet packages associated with the organization.</li>
                    @if (Model.IsPackageStagingEnabled) { <li>Delete your organization's private staged packages and symbols, including any pending promotions.</li> }
                </ul>
            </p>
            @if (Model.HasPackagesThatWillBeOrphaned || Model.HasAdditionalMembers)
            {
                @if (Model.HasPackagesThatWillBeOrphaned)
                {
                    <p>Before deleting your organization, you must transfer ownership of any package where you are the sole owner, using the <i>manage owners</i> <i class="ms-Icon ms-Icon--People" aria-hidden="true"></i> button for that package below. Read more about <a href="https://go.microsoft.com/fwlink/?linkid=862794">Manage package owners.</a></p>
                    <partial name="~/Views/Users/_UserPackagesListForDeletedAccount.cshtml" model="Model" />
                }
                @if (Model.HasAdditionalMembers)
                {
                    <p>Before deleting your organization, you must remove any other members from it using the <a asp-controller="Organizations" asp-action="ManageOrganization" asp-route-accountName="@Model.AccountName">manage organization</a> page.</p>
                    <partial name="_OrganizationMembersListForDeletedAccount" model="Model.AdditionalMembers" />
                }
            }
            else
            {
                <div class="form-group danger-zone">
                    <form asp-controller="Organizations" asp-action="RequestAccountDeletion" method="post" id="delete-organization">
                        @Html.AntiForgeryToken()
                        <p><strong>By proceeding, I understand that I am relinquishing my organization's ownership of any packages and any package ID prefix reservations.</strong></p>
                        <div class="row form-group">
                            <div class="col-sm-6"><input type="submit" class="btn btn-brand-danger form-control" id="delete-organization-submit" value="Delete organization" /></div>
                            <div class="col-sm-6"><button type="button" onclick="window.location.href= '@Url.Action("Index", "Home")'" class="btn btn-brand-secondary form-control" id="cancel-delete-organization">Cancel</button></div>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</section>

@section BottomScripts {
    <script type="text/javascript">
        $(function () {
            $('#delete-organization').submit(function(e) {
                if (!confirm('Are you sure you want to continue to delete this organization?')) { e.preventDefault(); }
            });
        });
    </script>
}
