@model IEnumerable<OrganizationMemberViewModel>
@using System.Security.Cryptography
@using System.Text

<div class="row user-package-list align-left">
    <div class="col-md-12 align-left ">
        <div class="panel-collapse collapse in" id="packages-Packages" aria-expanded="true">
            <div class="list-packages" role="list">
                <table class="table align-left" aria-label="Organization Members">
                    <thead><tr class="manage-package-headings"><th class="hidden-xs"></th><th>Username</th><th>Membership</th></tr></thead>
                    <tbody>
                        @foreach (var member in Model)
                        {
                            var normalizedEmail = (member.EmailAddress ?? string.Empty).Trim().ToLowerInvariant();
                            var hash = Convert.ToHexString(MD5.HashData(Encoding.UTF8.GetBytes(normalizedEmail))).ToLowerInvariant();
                            var gravatarUrl = $"https://www.gravatar.com/avatar/{hash}?s=32&d=identicon";
                            var profileUrl = Url.Action("Profile", "Users", new { username = member.Username });
                            var username = member.Username ?? string.Empty;
                            <tr class="manage-package-listing">
                                <td class="align-middle hidden-xs"><img src="@gravatarUrl" alt="gravatar" title="@member.Username" width="32" height="32" /></td>
                                <td class="align-middle package-id"><a href="@profileUrl">@(username.Length > 35 ? username.Substring(0, 35) + "…" : username)</a></td>
                                <td class="align-middle text-nowrap">@(member.IsAdmin ? "Administrator" : "Collaborator")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
