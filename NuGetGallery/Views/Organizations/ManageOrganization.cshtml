@model OrganizationAccountViewModel
@using System.Text.Json
@{
    var account = Model.Account;
    ViewData["Title"] = "Manage Organization";
    var membership = Model.Account.GetMembershipOfUser(CurrentUser);
    var membershipString = membership == null
        ? "You are not a member of this organization."
        : membership.IsAdmin ? "You are an administrator of this organization." : "You are a collaborator of this organization.";
    var permissionsString = "";
    if (Model.CanManage)
    {
        if (!Model.CanManageMemberships) { permissionsString = "You must be an administrator to change its members."; }
    }
    else
    {
        permissionsString = Model.CanManageMemberships
            ? "You must be an administrator to make changes to its email settings and profile picture."
            : "You must be an administrator to make changes to it.";
    }
    if (!string.IsNullOrEmpty(permissionsString)) { permissionsString = " " + permissionsString; }
    var initialDataJson = JsonSerializer.Serialize(new
    {
        AccountName = Model.AccountName,
        Members = Model.Members.Select(m => new
        {
            Username = m.Username,
            IsAdmin = m.IsAdmin,
            IsCurrentUser = m.Username.Equals(CurrentUser.Username, StringComparison.OrdinalIgnoreCase),
            Pending = m.Pending,
            GravatarUrl = m.GravatarUrl
        }),
        AddMemberUrl = Url.Action("AddOrganizationMember", "Organizations", new { accountName = Model.AccountName }),
        CancelMemberRequestUrl = Url.Action("CancelOrganizationMembershipRequest", "Organizations", new { accountName = Model.AccountName }),
        UpdateMemberUrl = Url.Action("UpdateOrganizationMember", "Organizations", new { accountName = Model.AccountName }),
        DeleteMemberUrl = Url.Action("DeleteOrganizationMember", "Organizations", new { accountName = Model.AccountName }),
        ProfileUrlTemplate = Url.Action("Profile", "Users", new { username = "__username__" })
    });
}

<section role="main" class="container main-container page-manage-organizations">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <nav aria-label="breadcrumb"><ol class="breadcrumb"><li><a asp-controller="Organizations" asp-action="ManageMyOrganizations">Organizations</a></li><li class="active" aria-current="page">@Model.AccountName</li></ol></nav>
            <p>@membershipString@permissionsString</p>

            <partial name="_AccountConfirmationNotices" model="Model" />
            <partial name="_AccountChangeEmail" model="Model" />
            <partial name="_AccountChangeNotifications" model="Model" />
            <partial name="_AccountProfilePicture" model="Model" />

            <div id="manage-organization-members-container"><partial name="_OrganizationAccountManageMembers" model="Model" /></div>

            @if (Model.IsCertificatesUIEnabled)
            {
                <partial name="_AccountCertificates" model="Model" />
            }
            @if (Model.CanManage)
            {
                <section id="delete-organization" class="organization-section">
                    <h2>Delete</h2>
                    <p>Delete this organization</p>
                    <div class="row form-group">
                        <div class="col-sm-6"><button type="button" onclick="window.location.href = '@Url.Action("DeleteAccount", "Organizations", new { accountName = Model.AccountName })'" class="btn btn-brand-danger form-control">Delete</button></div>
                        <div class="col-sm-6"><button type="button" class="btn btn-brand-secondary form-control" id="cancel-delete-organization">Cancel</button></div>
                    </div>
                </section>
            }
        </div>
    </div>
</section>

@section BottomScripts {
    <script type="text/javascript">
        var initialData = @Html.Raw(initialDataJson);
    </script>
    <script src="~/Scripts/gallery/page-manage-organization.min.js" asp-append-version="true"></script>
    @if (Model.IsCertificatesUIEnabled)
    {
        <script src="~/Scripts/gallery/certificates.min.js" asp-append-version="true"></script>
        <script type="text/javascript">
            CertificatesManagement.init(@Html.Raw(JsonSerializer.Serialize(Url.Action("AddOrganizationCertificate", "Organizations", new { accountName = account.Username }))), @Html.Raw(JsonSerializer.Serialize(Url.Action("GetOrganizationCertificates", "Organizations", new { accountName = account.Username }))));
        </script>
    }
    <script type="text/html" id="validation-errors">
        <div data-bind="foreach:$data" class="validation-error-message-list"><div class="alert alert-danger" role="alert"><span data-bind="text:$data"></span></div></div>
    </script>
}
