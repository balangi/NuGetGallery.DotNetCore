@using System.Collections.Generic
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

@{
    if (ViewData["Sections"] == null)
    {
        ViewData["Sections"] = new Lazy<List<string>>(() => new List<string>());
    }

    Layout = HostEnvironment.ContentRootFileProvider
        .GetFileInfo("Branding/Views/Shared/Layout.cshtml").Exists
        ? "~/Branding/Views/Shared/Layout.cshtml"
        : "~/Views/Shared/gallery/Layout.cshtml";
}
