@model ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
    ViewBag.SmPageColumns = GalleryConstants.ColumnsAuthenticationSm;
    ViewBag.MdPageColumns = GalleryConstants.ColumnsAuthenticationMd;
}

<section role="main" class="container main-container page-forgot-password">
    @if (!Model.IsPasswordLoginEnabled)
    {
        <div class="deprecate-alert text-center">
            @ViewHelpers.AlertWarning(@<text>@Strings.ForgotPassword_Disabled</text>)
        </div>
    }
    else if (this.Config.Current.DeprecateNuGetPasswordLogins)
    {
        <div class="deprecate-alert text-center">
            @ViewHelpers.AlertPasswordDeprecation()
        </div>
    }

    <div class="row">
        <div class="@ViewHelpers.GetColumnClasses(ViewBag) text-center">
            <h1>Forgot Password</h1>

            <p>We are sorry to hear you forgot your NuGet.org account password. Enter your email below and we will send instructions to reset your password.</p>

            <div class="forgot-form text-left">
                <form method="post">
                    @* The Form Tag Helper emits the anti-forgery token for this POST. *@
                    <div class="form-group @(ViewData.ModelState[nameof(Model.Email)]?.Errors.Count > 0 ? "has-error" : string.Empty)">
                        <label asp-for="Email" class="control-label required"></label>
                        <input asp-for="Email" class="form-control input-brand" />
                        <span asp-validation-for="Email" class="help-block"></span>
                    </div>
                    <div class="form-group has-error-brand">
                        <div asp-validation-summary="ModelOnly" class="help-block" role="alert"></div>
                    </div>
                    <div class="form-group">
                        <input id="Submit" type="submit" class="btn btn-brand form-control" value="Send" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section bottomScripts {
    @ViewHelpers.RecaptchaScripts(Config.Current.ReCaptchaPublicKey, "Submit")
}
