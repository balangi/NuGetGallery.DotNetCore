@model UserAccountViewModel

<section class="account-section" id="change-password">
    <details open>
        <summary><strong>Password Login</strong>
        @if (Config.Current.DeprecateNuGetPasswordLogins)
        { <span class="ms-Icon ms-Icon--Warning warning-icon" title="Password login is deprecated, please disable this login." aria-hidden="true"></span> }
        <em>@(Model.HasPassword ? "(Enabled)" : "(Disabled)")</em></summary>
        <div class="account-section-body">
        @if (CurrentUser.Confirmed)
        {
            <form asp-controller="Users" asp-action="ChangePassword" method="post" aria-label="Change password login">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                @if (Config.Current.DeprecateNuGetPasswordLogins)
                {
                    <div class="form-group"><span><i class="ms-Icon ms-Icon--Warning warning-icon" aria-hidden="true"></i> Password login is deprecated, please @(Model.SignInCredentialCount > 1 ? "disable this login." : "link to a Microsoft account and disable this login.")</span></div>
                }
                @if (Model.SignInCredentialCount > 1)
                {
                    <div class="form-group">
                        <label class="brand-checkbox"><input asp-for="ChangePassword.DisablePasswordLogin" type="checkbox" /><span asp-for="ChangePassword.DisablePasswordLogin">@Html.DisplayNameFor(m => m.ChangePassword.DisablePasswordLogin)</span></label>
                        <span asp-validation-for="ChangePassword.DisablePasswordLogin" class="text-danger"></span>
                    </div>
                }
                else { <input asp-for="ChangePassword.DisablePasswordLogin" type="hidden" /> }
                @if (Model.HasPassword)
                {
                    <div class="form-group"><label asp-for="ChangePassword.OldPassword"></label><input asp-for="ChangePassword.OldPassword" type="password" class="form-control input-brand" autocomplete="current-password" /><span asp-validation-for="ChangePassword.OldPassword" class="text-danger"></span></div>
                    <div class="form-group"><label asp-for="ChangePassword.NewPassword"></label><input asp-for="ChangePassword.NewPassword" type="password" class="form-control input-brand" autocomplete="new-password" /><span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span></div>
                    <div class="form-group"><label asp-for="ChangePassword.VerifyPassword"></label><input asp-for="ChangePassword.VerifyPassword" type="password" class="form-control input-brand" autocomplete="new-password" /><span asp-validation-for="ChangePassword.VerifyPassword" class="text-danger"></span></div>
                }
                else { <p>To enable password login, an email will be sent to '@(CurrentUser.EmailAddress ?? CurrentUser.UnconfirmedEmailAddress)'.</p> }
                <div class="row form-group"><div class="col-sm-6"><input type="submit" class="btn btn-brand form-control" value="@(Model.HasPassword ? "Save" : "Enable Password Login")" /></div><div class="col-sm-6"><button type="button" class="btn btn-brand-secondary form-control" id="cancel-change-password">Cancel</button></div></div>
            </form>
        }
        else { <p>To enable password login, please <a href="@Url.ConfirmationRequired()">confirm</a> your account.</p> }
        </div>
    </details>
</section>
