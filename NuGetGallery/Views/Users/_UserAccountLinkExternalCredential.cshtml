@model UserAccountViewModel

<section class="account-section" id="create-external-credential">
    <details open>
        <summary><strong>Login Account</strong>
        @if (Config.Current.DeprecateNuGetPasswordLogins)
        { <span class="ms-Icon ms-Icon--Warning warning-icon" title="@Strings.PasswordLoginDeprecated" aria-hidden="true"></span> }
        Microsoft account</summary>
        <div class="account-section-body">
            <p>Please link your Microsoft account to sign in to @(Config.Current.Brand).</p>
            <form asp-controller="Users" asp-action="LinkOrChangeExternalCredential" method="post">
                @Html.AntiForgeryToken()
                <div class="row form-group"><div class="col-sm-6"><button class="btn btn-brand-danger btn-block" type="submit" data-confirm="This action will replace your password login with the new Microsoft login account. Are you sure you want to change your login account?">Link Microsoft Account</button></div><div class="col-sm-6"><button type="button" class="btn btn-brand-secondary btn-block" id="cancel-create-external-credential">Cancel</button></div></div>
            </form>
        </div>
    </details>
</section>
