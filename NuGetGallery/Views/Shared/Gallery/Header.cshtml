@{
    var ShowWarningIndicator = Config.Current.DeprecateNuGetPasswordLogins && (User.HasPasswordLogin() || (!User.HasMultiFactorAuthenticationEnabled() && User.WasMicrosoftAccountUsedForSignin()));
    var ShowPasswordDeprecationBanner = TempData.ContainsKey("ShowPasswordDeprecationWarning")
        && Convert.ToBoolean(TempData["ShowPasswordDeprecationWarning"].ToString())
        && (User.Identity?.IsAuthenticated == true)
        && Config.Current.DeprecateNuGetPasswordLogins
        && User.HasPasswordLogin();
    var rawErrorMessage = TempData.ContainsKey("RawErrorMessage") ? TempData["RawErrorMessage"].ToString() : null;
    var activeTab = ViewBag.Tab as string;
    var currentUserName = User.Identity?.Name;
}

<div id="cookie-banner"></div>

@if (!string.IsNullOrWhiteSpace(Config.Current.WarningBanner))
{
    <div class="container-fluid banner banner-bright text-center">
        <div class="row">
            <div class="col-sm-12">
                <i class="ms-Icon ms-Icon--Warning" aria-hidden="true"></i>
                <span>@Config.Current.WarningBanner</span>
            </div>
        </div>
    </div>
}

@if (ViewBag.DisplayBanner == true)
{
    <div class="container-fluid banner banner-info text-center">
        <div class="row">
            <div class="col-sm-12">
                <span>
                    &#128075; What do you think about NuGet.org? We're looking for feedback from developers like you. <a href="https://aka.ms/NuGetSurvey" target="_blank">Take the survey.</a>
                </span>
            </div>
        </div>
    </div>
}

<nav class="navbar navbar-inverse" role="navigation">
    <div class="container">
        <div class="row">
            <div class="col-sm-12 text-center">
                <a href="#" id="skipToContent" class="showOnFocus" title="Skip To Content">Skip To Content</a>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a href="@Url.Home()" class="home-link">
                        <div class="navbar-logo nuget-logo-image" alt="NuGet home" role="img" aria-label="NuGet Home" @ViewHelpers.ImageFallback(Url.Absolute("~/Content/gallery/img/logo-header-94x29.png"))></div>
                    </a>
                </div>
                <div id="navbar" class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">
                        <li class="@(activeTab == "Packages" ? "active" : null)">
                            <a name="Packages" aria-current="@(activeTab == "Packages" ? "page" : null)" href="@Url.PackageList()" title="" class="@GalleryConstants.SearchFilterIds.PackagesLinkClass"><span>Packages</span></a>
                        </li>
                        <li class="@(activeTab == "Upload" ? "active" : null)">
                            <a name="Upload" aria-current="@(activeTab == "Upload" ? "page" : null)" href="@Url.UploadPackage()" title="" class=""><span>Upload</span></a>
                        </li>
                        @if (StatisticsHelper.IsStatisticsPageAvailable)
                        {
                            <li class="@(activeTab == "Statistics" ? "active" : null)">
                                <a name="Statistics" aria-current="@(activeTab == "Statistics" ? "page" : null)" href="@Url.Statistics()" title="" class=""><span>Statistics</span></a>
                            </li>
                        }
                        @if ((User.Identity?.IsAuthenticated == true) && AdminHelper.IsAdminPanelEnabled && User.IsInRole(CoreConstants.AdminRoleName))
                        {
                            <li class="@(activeTab == "Admin" ? "active" : null)">
                                <a name="Admin" aria-current="@(activeTab == "Admin" ? "page" : null)" href="@Url.Admin()" title="" class=""><span>Admin</span></a>
                            </li>
                        }
                        <li class="@(activeTab == "Documentation" ? "active" : null)">
                            <a name="Documentation" aria-current="@(activeTab == "Documentation" ? "page" : null)" href="https://docs.microsoft.com/nuget/" title="" class=""><span>Documentation</span></a>
                        </li>
                        <li class="@(activeTab == "Downloads" ? "active" : null)">
                            <a name="Downloads" aria-current="@(activeTab == "Downloads" ? "page" : null)" href="@Url.Downloads()" title="" class=""><span>Downloads</span></a>
                        </li>
                        <li class="@(activeTab == "Blog" ? "active" : null)">
                            <a name="Blog" aria-current="@(activeTab == "Blog" ? "page" : null)" href="https://blog.nuget.org/" title="" class=""><span>Blog</span></a>
                        </li>
                    </ul>
                    @if (ShowAuthInHeader)
                    {
                        <ul class="nav navbar-nav navbar-right">
                            @if (User.Identity?.IsAuthenticated != true)
                            {
                                var returnUrl = ViewData.ContainsKey(GalleryConstants.ReturnUrlViewDataKey) ? (string)ViewData[GalleryConstants.ReturnUrlViewDataKey] : Request.Path.ToString() + Request.QueryString.ToString();
                                <li class="@(activeTab == "Sign in" ? "active" : null)">
                                    <a name="Sign in" aria-current="@(activeTab == "Sign in" ? "page" : null)" href="@Url.LogOn(returnUrl)" title="Sign in to an existing NuGet.org account" class=""><span>Sign in</span></a>
                                </li>
                            }
                            else
                            {
                                <li class="@(activeTab == currentUserName ? "active" : null) dropdown">
                                    <a href="#" aria-current="@(activeTab == currentUserName ? "page" : null)" id="account-dropdown" class="dropdown-toggle" title="Open profile dropdown" data-toggle="dropdown">
                                        <div>
                                            @if (ShowWarningIndicator)
                                            {
                                                <span class="ms-Icon ms-Icon--Warning warning-icon" aria-hidden="true"></span>
                                            }
                                            <b><span>@currentUserName</span></b>
                                            <span class="caret"></span>
                                        </div>
                                    </a>
                                    <ul class="dropdown-menu" role="menu" aria-labelledby="account-dropdown">
                                        <li class="dropdown-header row">
                                            <div class="col-sm-3">
                                                @ViewHelpers.GravatarImage(
                                                    Url,
                                                    CurrentUser.EmailAddress,
                                                    CurrentUser.Username,
                                                    size: 50)
                                            </div>
                                            <div class="col-sm-9 dropdown-profile">
                                                <span class="dropdown-username">@User.Identity.Name.Abbreviate(20)</span>
                                                <br />
                                                <span class="dropdown-email">@CurrentUser.EmailAddress.Abbreviate(25)</span>
                                            </div>
                                        </li>
                                        @if ((User.Identity?.IsAuthenticated == true) && AdminHelper.IsAdminPanelEnabled && User.IsInRole(CoreConstants.AdminRoleName))
                                        {
                                            <li class="divider"></li>
                                            <li role="presentation"><a href="@Url.Admin()" role="menuitem">Admin</a></li>
                                        }
                                        <li class="divider"></li>
                                        <li role="presentation"><a href="@Url.User(CurrentUser.Username)" role="menuitem">View Profile</a></li>
                                        <li role="presentation">
                                            <a href="@Url.AccountSettings()" role="menuitem">
                                                Account Settings
                                                @if (ShowWarningIndicator)
                                                {
                                                    <span class="ms-Icon ms-Icon--Warning warning-icon" aria-hidden="true"></span>
                                                }
                                            </a>
                                        </li>

                                        <li role="presentation"><a href="@Url.ManageMyTrustedPublishing()" role="menuitem">Trusted Publishing</a></li>
                                        <li role="presentation"><a href="@Url.ManageMyApiKeys()" role="menuitem">API Keys <span class="label label-warning" style="font-size:10px;vertical-align:middle;">Not recommended</span></a></li>

                                        <li class="divider"></li>
                                        <li role="presentation"><a href="@Url.ManageMyOrganizations()" role="menuitem">Manage Organizations</a></li>
                                        <li role="presentation"><a href="@Url.ManageMyPackages()" role="menuitem">Manage Packages</a></li>
                                        <li role="presentation"><a href="@Url.UploadPackage()" role="menuitem">Upload Package</a></li>
                                        <li class="divider"></li>
                                        <li role="presentation">
                                            <form id="log-off-form" action="@Url.Action("LogOff", "Authentication")" method="post" class="navbar-form" style="margin:0;padding:0;border:0;box-shadow:none;">
                                                <input type="hidden" name="returnUrl" value="@Url.Current()" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" role="menuitem" class="btn btn-link" style="display:block;width:100%;padding:3px 20px;text-align:left;white-space:nowrap;color:#333;text-decoration:none;background:transparent;border:0;">Sign Out</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.ShowSearchInNavbar != false)
    {
        <div id="search-bar-header" class="container search-container">
            <div class="row">
                <form aria-label="Package search bar" class="col-sm-12" id="@GalleryConstants.SearchFilterIds.SimpleSearchFormId" action="@Url.PackageList()" method="get">
                    <partial name="_SearchBar" />
                    <partial name="_AutocompleteTemplate" />
                </form>
            </div>
        </div>
    }
</nav>

@if (TempData.ContainsKey("Message"))
{
    <div class="alert-transient @(ViewBag.HasJumbotron == true ? "alert-transient-jumbotron" : string.Empty)">
        <div class="container">
            <div class="row">
                <div class="col-sm-12" role="alert" aria-live="assertive">
                    <div class="alert alert-info" role="alert">@TempData["Message"]</div>
                </div>
            </div>
        </div>
    </div>
}

@if (TempData.ContainsKey("WarningMessage"))
{
    <div class="alert-transient @(ViewBag.HasJumbotron == true ? "alert-transient-jumbotron" : string.Empty)">
        <div class="container">
            <div class="row">
                <div class="col-sm-12" role="alert" aria-live="assertive">
                    <div class="alert alert-warning" role="alert">@((string)TempData["WarningMessage"])</div>
                </div>
            </div>
        </div>
    </div>
}

@if (TempData.ContainsKey("ErrorMessage"))
{
    <div class="alert-transient @(ViewBag.HasJumbotron == true ? "alert-transient-jumbotron" : string.Empty)">
        <div class="container">
            <div class="row">
                <div class="col-sm-12" role="alert" aria-live="assertive">
                    <div class="alert alert-danger" role="alert">@((string)TempData["ErrorMessage"])</div>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(rawErrorMessage))
{
    <div class="alert-transient @(ViewBag.HasJumbotron == true ? "alert-transient-jumbotron" : string.Empty)">
        <div class="container">
            <div class="row">
                <div class="col-sm-12" role="alert" aria-live="assertive">
                    <div class="alert alert-danger" role="alert">@rawErrorMessage</div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowPasswordDeprecationBanner)
{
    <div class="alert-transient @(ViewBag.HasJumbotron == true ? "alert-transient-jumbotron" : string.Empty)">
        <div class="container">
            <div class="row">
                <div class="col-sm-12" role="alert" aria-live="assertive">
                    @if (User.HasExternalLogin())
                    {
                        <div class="alert alert-warning" role="alert">NuGet.org password login is no longer supported. Go to <a href="@Url.AccountSettings()">Account Settings</a> to disable your password login and use Microsoft account to sign in to the @(this.Config.Current.Brand).</div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">NuGet.org password login is no longer supported. Go to <a href="@Url.AccountSettings()">Account Settings</a> and link a Microsoft account to sign in to the @(this.Config.Current.Brand).</div>
                    }
                </div>
            </div>
        </div>
    </div>
}
