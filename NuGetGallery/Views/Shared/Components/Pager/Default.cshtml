@model NuGetGallery.IPreviousNextPager

<ul class="pager">
    <li class="previous">
        @if (Model.HasPreviousPage)
        {
            <a href="@Model.PreviousPageUrl" title="Go to the previous page.">Previous</a>
        }
        else
        {
            <text>Previous</text>
        }
    </li>
    <li class="next">
        @if (Model.HasNextPage)
        {
            <a href="@Model.NextPageUrl" title="Go to the next page.">Next</a>
        }
        else
        {
            <text>Next</text>
        }
    </li>
</ul>


