@model NuGetGallery.ViewModels.AccordionBarViewModel

<li id="@Model.ItemId" class="accordion-item @(Model.Enabled ? "accordion-item-enabled" : "accordion-item-disabled")">
    <div class="accordion-item-header">
        @if (Model.Actions != null)
        {
            <div class="accordion-item-actions" id="@Model.ActionsId">
                @Model.Actions
            </div>
        }
        <span class="accordion-item-title">
            @Model.Title
        </span>
        @if (Model.Subtitle != null)
        {
            <span class="accordion-item-subtitle">
                @Model.Subtitle
            </span>
        }
    </div>
    @if (Model.Content != null)
    {
        <div id="@Model.ContentDropDownId" class="accordion-item-content @Model.ContentHiddenClass">
            @Model.Content
        </div>
    }
</li>


