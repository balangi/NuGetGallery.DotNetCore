@* Converted from ASP.NET MVC 5 to ASP.NET Core 9 MVC Razor. *@
@model NuGetGallery.ViewModels.LogOnViewModel
@using NuGetGallery
@inject NuGetGallery.Configuration.IGalleryConfigurationService Config

@functions {
    private string ErrorClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
            ? "has-error"
            : string.Empty;
    }
}

@{
    var returnUrl = ViewData.TryGetValue(GalleryConstants.ReturnUrlViewDataKey, out var returnUrlValue)
        ? returnUrlValue as string
        : (Context.Request.Path + Context.Request.QueryString).ToString();
}

<form asp-controller="Authentication" asp-action="Register" method="post" asp-antiforgery="true">
    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
    <input type="hidden" name="LinkingAccount" value="@(Model.External != null ? "True" : "False")" />

    @if (Model.External != null)
    {
        <input type="hidden" asp-for="External.ProviderAccountNoun" />
        <input type="hidden" asp-for="External.AccountName" />
    }

    <div class="form-group @ErrorClass("Register")">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </div>

    <div class="form-group @ErrorClass("Register.Username")">
        <label asp-for="Register.Username" class="control-label"></label><!-- Original field was marked isrequired; retain a visible required indicator. -->
        <span class="required" aria-hidden="true">*</span>
        <input asp-for="Register.Username" class="form-control input-brand" />
        <span asp-validation-for="Register.Username" class="text-danger"></span>
    </div>

    @if (Model.External == null)
    {
        <div class="form-group @ErrorClass("Register.Password")">
            <label asp-for="Register.Password" class="control-label"></label>
            <input asp-for="Register.Password" class="form-control input-brand" type="password" />
            <span asp-validation-for="Register.Password" class="text-danger"></span>
        </div>
    }

    <div class="form-group @ErrorClass("Register.EmailAddress")">
        <label asp-for="Register.EmailAddress" class="control-label"></label>
        @if (Model.External != null && !string.IsNullOrEmpty(Model.Register.EmailAddress))
        {
            <input type="hidden" asp-for="Register.EmailAddress" />
            <p>@Model.Register.EmailAddress</p>
        }
        else
        {
            <input asp-for="Register.EmailAddress" class="form-control input-brand" type="email" />
        }
        <span asp-validation-for="Register.EmailAddress" class="text-danger"></span>
    </div>

    <div class="panel panel-default text-center">
        <div class="panel-body">
            By clicking Register you agree that you have read and accept our
            <a asp-controller="Pages" asp-action="Terms">Terms of Use</a> and <a asp-controller="Pages" asp-action="Privacy">Privacy Statement</a>.
        </div>
    </div>
    <div class="form-group">
        <input type="submit" class="btn btn-brand form-control" value="Register" />
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
